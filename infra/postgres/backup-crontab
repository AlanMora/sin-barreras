# Respaldos con pgBackRest (hora UTC). Completo semanal, incremental diario.
# El archivado continuo de WAL permite además recuperar a cualquier instante.
0 9 * * 0   gosu postgres pgbackrest --stanza=sin-barreras --type=full backup >> /var/log/pgbackrest/cron.log 2>&1
0 9 * * 1-6 gosu postgres pgbackrest --stanza=sin-barreras --type=incr backup >> /var/log/pgbackrest/cron.log 2>&1
