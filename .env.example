# Copia este archivo a .env para cambiar los puertos que se publican en tu
# máquina (solo en 127.0.0.1). Los valores por defecto evitan chocar con un
# Postgres o Redis que ya tengas en 5432/6379.
SB_POSTGRES_PORT=15432
SB_VALKEY_PORT=16379
SB_PORT=8000
SB_C5_MOCK_PORT=8090
SB_PROMETHEUS_PORT=9091
SB_GRAFANA_PORT=3300

# Número de respaldo para SMS/llamada cuando no hay conexión (build de la PWA).
VITE_FALLBACK_PHONE=+523322967625
